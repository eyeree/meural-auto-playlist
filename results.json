    {
      id: 43,
      order: 4,
      name: 'New to Membership',
      description: "Here you'll find artists, playlists, and works that we've recently added to the Meural Membership.",
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/nwfdNKdh8facZGzghAyFnJlnQHyHpnuE.gif',
      featuredAt: '2022-06-04T10:16:00-0400',
      favoriteCount: 1961,
      avatar: [Object],
      hero: [Object],
      itemCount: 870,
      updatedAt: '2022-06-04T10:16:48-0400'
    },
    {
      id: 41,
      order: 7,
      name: 'The Little Prince™ (Le Petit Prince)',
      description: '_The Little Prince_ is a poetic tale, illustrated by Antoine de Saint-Exupéry in watercolors, in which a pilot stranded in the desert meets a young prince fallen to Earth from a tiny asteroid. The most translated non-religious book in the world, _The Little Prince_ is a philosophical story that resonates with readers of all ages through its messages of respect for humanity, friendship, authenticity, and charity.',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/ikrdD5tE2kgKJtXANZCQY8zimBmdMSdP.png',
      featuredAt: '2021-05-27T11:31:00-0400',
      favoriteCount: 156,
      avatar: [Object],
      hero: [Object],
      itemCount: 3,
      updatedAt: '2021-05-27T12:49:40-0400'
    },
    {
      id: 40,
      order: 19,
      name: 'The Art of Science',
      description: 'Artworks from the intersection of art and science—the result of various artists’ interest in the world they see around them, as well as the very process of trying to see more.',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/VKnJ20gTsFJczmXPUYIGzk9q46qe9cT7.png',
      featuredAt: '2019-03-24T18:00:00-0400',
      favoriteCount: 134,
      avatar: [Object],
      hero: [Object],
      itemCount: 93,
      updatedAt: '2019-04-30T18:54:39-0400'
    },
    {
      id: 37,
      order: 11,
      name: 'Meural Exclusives',
      description: "Meural continually works with artists and rights holders to get art you won't find anywhere else. This channel is dedicated to our Meural Exclusives.",
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/2MP9neD59O4GQ9UNs75W3QYFJeMJdcSD.png',
      featuredAt: '2021-01-19T10:59:00-0500',
      favoriteCount: 163,
