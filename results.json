    {
      id: 45,
      order: 7,
      name: 'Art Moves',
      description: 'A collection of artworks, playlists, and artists that put art into motion—literally.',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/nJlkoclx7d6KPNqwWsSGSQJM4z4RwTk8.gif',
      featuredAt: '2022-10-27T12:47:00-0400',
