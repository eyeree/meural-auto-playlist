channels {
  data: [
    {
      id: 60,
      order: 1,
      name: 'SuperRare',
      description: 'The premier curated NFT marketplace for cutting edge NFT culture.\n' +
        '\n' +
        'Learn more at [SuperRare](superrare.com)',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/lD7BsLBdg9WS4WlOg410xnVdaJJA7ho7.png',
      featuredAt: '2022-10-06T11:46:00-0400',
      favoriteCount: 173,
      avatar: [Object],
      hero: [Object],
      itemCount: 74,
      updatedAt: '2022-10-06T11:46:52-0400'
    },
    {
      id: 59,
      order: 30,
      name: 'Async',
      description: '[Async Art](https://async.art/) is a new art movement built on the blockchain. Create, collect, and trade programmable art: digital paintings split into "Layers", which you can use to affect the overall image. Art that can evolve over time, react to its owners, or follow a stock price is now all possible with programmable art. Launched in February 2020, there has already been over $11M in bid volume and over $4.3M in artist sales.',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/PSmayBmmeX1S0Jz9VwmfyhC4tcH961eX.jpg',
      featuredAt: '2022-04-26T08:14:00-0400',
      favoriteCount: 307,
      avatar: [Object],
      hero: [Object],
      itemCount: 228,
      updatedAt: '2022-04-26T08:14:38-0400'
    },
    {
      id: 57,
      order: 10,
      name: 'SeeMe',
      description: 'SeeMe is a global platform that uses a competitive process through open call competitions to identify, select and support the best emerging artists around the world and give them access to a global audience. SeeMe’s competitions are totally merit based and include thousands of artists from over 35 countries globally. The judging is blind and includes art world luminaries from Sotheby’s Institute, Meural, Twitter’s Art Program, The Yard, Standard Arts, and others along with major art critics like New York Magazine’s Jerry Saltz. SeeMe exhibitions have been held around the world including New York during Armory Week, Art Basel Miami at SCOPE, the White House (during the Obama era), and the Louvre in Paris. Learn more at [see.me](https://www.see.me/)',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/ki7D17S9Y6VldwP9YI0JF5XhzESRJSN7.png',
      featuredAt: '2021-11-29T10:01:00-0500',
      favoriteCount: 85,
      avatar: [Object],
      hero: [Object],
      itemCount: 39,
      updatedAt: '2021-11-29T10:01:06-0500'
    },
    {
      id: 55,
      order: 10,
      name: 'Sharecare Windows',
      description: "Sharecare Windows' is an award-winning globally recognized producer of original HD and VR relaxation and wellness videos, empowering viewers to find stillness and peace in their everyday life. Sharecare Windows’ video library is specifically curated to include five specialty categories containing with hundreds of hours of relaxation, spiritual, meditation, sleep and background video programming.\n" +
        '\n' +
        'Clinical usage has shown Sharecare Windows’ videos to be effective in reducing intrusive noise levels, encouraging healthy sleep patterns and reducing stress.',
      logo: 'https://d3k8cp7ga1ip8x.cloudfront.net/media/meural/channel/9QdiwRpi8E6AaJaF15xkohQaaUxpY6IN.png',
      featuredAt: null,
      favoriteCount: 82,
      avatar: [Object],
      hero: [Object],
      itemCount: 30,
      updatedAt: '2020-09-28T12:01:57-0400'
    },
